# Terraform local provider cache — large binaries, regenerated by `terraform init`
.terraform/

# Terraform state — contains real Cumulus resource IDs and data.
# No remote backend is configured, so this file holds live infrastructure state.
# Must never be committed.
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Variable files — may contain secrets or environment-specific values.
# Not used yet in this project, but ignored defensively.
*.tfvars
*.tfvars.json

# Local overrides — meant to stay local, not shared
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI config that may contain credentials/tokens
.terraformrc
terraform.rc

# Ignore any HCL files that are not part of the project
.terraform.lock.hcl

