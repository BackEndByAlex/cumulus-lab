# Terraform local provider cache — large binaries, regenerated by `terraform init`
.terraform/

# Terraform state — contains real Cumulus resource IDs and data.
# No remote backend is configured, so this file holds live infrastructure state.
# Must never be committed.
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Variable files — may contain secrets or environment-specific values.
# Used by 02-load-balanced/terraform (terraform.tfvars holds the student's own public IP).
*.tfvars
*.tfvars.json

# Local overrides — meant to stay local, not shared
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI config that may contain credentials/tokens
.terraformrc
terraform.rc

# Ignore any HCL files that are not part of the project
.terraform.lock.hcl

# Ansible inventory is environment-specific (real Cumulus IP) — kept local, not shared.
# Note: this pattern has no leading slash, so it matches both
# 01-single-server/ansible/inventory.ini and 02-load-balanced/ansible/inventory.ini.
inventory.ini

# Ansible retry files — generated automatically after a failed playbook run
*.retry

# Ansible Vault files — encrypted secrets, but still not meant to be committed as plaintext-adjacent files
group_vars/**/vault.yml
*.vault
.vault_pass

# Contains environment-specific values (ansible_user, ansible_ssh_private_key_file path) — same reasoning as inventory.ini
01-single-server/ansible/group_vars/webserver.yml